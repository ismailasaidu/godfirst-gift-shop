rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Only an existing admin can change the role registry. A user may read their
    // own record to let the UI decide whether to display the admin navigation tab.
    match /admins/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }


    // Basic customer profile. A customer may only read or update their own profile.
    // The client cannot assign itself admin privileges: role is always treated as customer here.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && request.resource.data.uid == request.auth.uid && request.resource.data.role == 'customer';
      allow update: if isSelf(uid) && request.resource.data.uid == resource.data.uid && request.resource.data.role == 'customer';
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /storeSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'Payment confirmation pending');
      allow update, delete: if isAdmin();
    }
  }
}
