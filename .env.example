
# Paystack public key is safe to expose in the storefront. Use pk_test_ while testing.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_public_key
# Set this only in Netlify environment variables (never in frontend/.env VITE_ variables).
# PAYSTACK_SECRET_KEY=sk_test_replace_with_your_secret_key

# Required by secure admin email-test, order-status and stock-alert functions; also used to save verified orders.
# Keep server-side only; never commit the real JSON or expose it through VITE_ variables.
# Configure securely in Netlify/local server environment only; never prefix with VITE_.
# FIREBASE_SERVICE_ACCOUNT_JSON={...service account JSON...}

# Required for transactional emails sent by Paystack verification, admin order actions and stock alerts.
# Authenticate this sender/domain in Brevo before using it in production.
# Use a Brevo REST API key (typically starts with xkeysib-), NOT an SMTP key (typically starts with xsmtpkey-).
# BREVO_API_KEY=your_brevo_REST_API_key
# BREVO_SENDER_EMAIL=support@godfirstgiftshopworldwide.com
# BREVO_SENDER_NAME=God First Gift Shop Worldwide
# STORE_ADMIN_EMAIL=your_admin_inbox@example.com
# Required for full AI responses from the shopping assistant. Restricted keys must permit Responses API requests. Keep server-side only; never prefix with VITE_.
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4.1
